{
    "version": "2.0.0",
    "options": {
        "env": {
            "JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-17.0.18.8-hotspot",
            "ANDROID_SDK_ROOT": "${env:LOCALAPPDATA}\\Android\\Sdk"
        }
    },
    "tasks": [
        {
            "label": "Build Debug APK",
            "type": "shell",
            "command": ".\\gradlew.bat assembleDebug",
            "group": "build",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "command": ".\\gradlew.bat testDebugUnitTest",
            "group": "test",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Launch Emulator (EvCalcAVD)",
            "type": "shell",
            "command": "Start-Process -NoNewWindow \"${env:LOCALAPPDATA}\\Android\\Sdk\\emulator\\emulator.exe\" -ArgumentList \"-avd EvCalcAVD\"",
            "group": "none",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "Install & Run on Emulator",
            "type": "shell",
            "command": ".\\gradlew.bat installDebug",
            "dependsOn": "Build Debug APK",
            "group": "none",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        }
    ]
}
